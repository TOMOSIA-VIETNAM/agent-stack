{
  "name": "@tomosia/agent-stack",
  "version": "1.1.1",
  "description": "Generate .claude rules and skills for a project from a curated knowledge base, deterministically.",
  "type": "module",
  "license": "Apache-2.0",
  "author": {
    "name": "TOMOSIA VIETNAM"
  },
  "homepage": "https://github.com/TOMOSIA-VIETNAM/agent-stack#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/TOMOSIA-VIETNAM/agent-stack.git"
  },
  "bugs": {
    "url": "https://github.com/TOMOSIA-VIETNAM/agent-stack/issues"
  },
  "keywords": [
    "claude",
    "claude-code",
    "agent-skills",
    "rules",
    "skills",
    "scaffolding",
    "knowledge-base",
    "cli",
    "rails",
    "laravel"
  ],
  "bin": {
    "agent-stack": "dist/agent-stack.mjs"
  },
  "files": [
    "dist/",
    "knowledge/",
    "commands/",
    "agents/",
    ".claude-plugin/",
    "NOTICE"
  ],
  "engines": {
    "node": ">=20"
  },
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "esbuild src/cli.ts --bundle --platform=node --target=node20 --format=esm --outfile=dist/agent-stack.mjs --banner:js=\"import{createRequire as __cr}from'node:module';const require=__cr(import.meta.url);\"",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run typecheck && npm run test && npm run build",
    "sync": "node scripts/sync-upstream.mjs",
    "try": "node scripts/try.mjs",
    "new-framework": "node scripts/new-framework.mjs"
  },
  "dependencies": {
    "yaml": "^2.9.1",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "esbuild": "^0.28.2",
    "typescript": "^5.7.0",
    "vitest": "^4.1.11"
  }
}
